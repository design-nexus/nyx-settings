#!/usr/bin/env python3
"""Gaming headset controls for Settings, through HeadsetControl, and the ASTRO A50 X through
Gearbench's gearbench-ctl.

settings-headset pages | describe PAGE | set PAGE KEY VALUE

Headsets only report battery and chat-mix back; everything else is write-only,
so the page shows what was last set from here (kept in SETTINGS_EXTENSION_STATE).
The A50 X reports its settings back through Gearbench.

HEADSET_MOCK swaps the hardware for pretend headsets (see headset_mock.py).
"""

import glob
import html
import json
import os
import re
import shutil
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
STATE_DIR = os.environ.get("SETTINGS_EXTENSION_STATE") or os.path.expanduser("~/.local/state/settings/extensions/headset")

INACTIVE = [["0", "Never"], ["5", "5 minutes"], ["10", "10 minutes"], ["15", "15 minutes"],
            ["30", "30 minutes"], ["60", "1 hour"], ["90", "90 minutes"]]

MIC = "audio-input-microphone-symbolic"
EQ = "multimedia-volume-control-symbolic"
VOL = "audio-volume-high-symbolic"
LIGHT = "display-brightness-symbolic"
POWER = "system-shutdown-symbolic"
BT = "bluetooth-symbolic"
BELL = "preferences-system-notifications-symbolic"

ICONS = {"sidetone": MIC, "eq": EQ, "limiter": VOL, "mic-volume": MIC, "rotate-mute": MIC, "voice": VOL,
         "lights": LIGHT, "mute-led": LIGHT, "inactive": POWER, "bt-on": BT, "battery-warning": BELL}


def mock():
    """The pretend headsets, or None unless HEADSET_MOCK is set."""
    if not (os.environ.get("HEADSET_MOCK") or "").strip():
        return None
    if HERE not in sys.path:
        sys.path.insert(0, HERE)
    import headset_mock
    return headset_mock


def state_dir():
    return os.path.join(STATE_DIR, "mock") if mock() else STATE_DIR


def preview_supported():
    """Whether this Settings draws a preview pane beside the groups."""
    return any(k == "preview" for k in os.environ.get("SETTINGS_KINDS", "").split(" "))


def esc(text):
    return html.escape(str(text), quote=False)


def run(*args):
    if mock():
        return mock().headsetcontrol(list(args))
    try:
        return subprocess.run(["headsetcontrol", *args], capture_output=True, text=True, check=False)
    except FileNotFoundError:
        return subprocess.CompletedProcess(["headsetcontrol", *args], 127, "", "headsetcontrol isn't installed")


def devices():
    r = run("-o", "json")
    try:
        data = json.loads(r.stdout)
    except ValueError:
        return []
    return [d for d in data.get("devices", []) if d.get("status", "success") == "success"]


def page_id(d):
    vid = str(d.get("id_vendor", "")).replace("0x", "")
    pid = str(d.get("id_product", "")).replace("0x", "")
    return re.sub(r"[^a-z0-9]+", "-", f"{vid}-{pid}".lower()).strip("-") or "headset"


def find(pid):
    for i, d in enumerate(devices()):
        if page_id(d) == pid:
            return i, d
    raise SystemExit("that headset isn't connected")


def caps(d):
    return set(d.get("capabilities", []))


def state_file(pid):
    return os.path.join(state_dir(), f"{pid}.json")


def load_state(pid):
    if mock():
        return mock().last_set(state_dir(), pid)
    try:
        with open(state_file(pid)) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_state(pid, state):
    os.makedirs(state_dir(), exist_ok=True)
    tmp = state_file(pid) + ".tmp"
    with open(tmp, "w") as f:
        json.dump(state, f)
    os.replace(tmp, state_file(pid))


def name_of(d):
    return d.get("device") or " ".join(x for x in (d.get("vendor"), d.get("product")) if x) or "Headset"


def battery_text(d):
    b = d.get("battery") or {}
    status = b.get("status", "")
    level = b.get("level", -1)
    if status == "BATTERY_CHARGING":
        return "Charging" if level is None or level < 0 else f"{level}% · Charging"
    if status == "BATTERY_AVAILABLE" and level is not None and level >= 0:
        return f"{level}%"
    return "Not available (headset off?)"


def duration(minutes):
    """'15 hours', 'an hour', '40 minutes'; '' when HeadsetControl gave no time."""
    if not isinstance(minutes, (int, float)) or isinstance(minutes, bool) or minutes < 0:
        return ""
    if minutes < 60:
        return f"{round(minutes)} minutes"
    hours = round(minutes / 60)
    return "an hour" if hours == 1 else f"{hours} hours"


def battery_reading(d):
    b = d.get("battery") or {}
    status = b.get("status", "")
    level = b.get("level", -1)
    level = -1 if level is None else level
    if status == "BATTERY_CHARGING":
        left = duration(b.get("time_to_full_min"))
        return {"label": "Battery", "value": f"{level}%" if level >= 0 else "Charging",
                "sub": f"Full in about {left}" if left else "Charging", "tone": "good"}
    if status == "BATTERY_AVAILABLE" and level >= 0:
        left = duration(b.get("time_to_empty_min"))
        tone = "bad" if level <= LOW else "warn" if level <= 30 else "good"
        return {"label": "Battery", "value": f"{level}%", "sub": f"About {left}" if left else "", "tone": tone}
    return {"label": "Battery", "value": "Not available", "sub": "Headset off?"}


def lean(mix):
    return "Even" if 60 <= mix <= 68 else ("More game" if mix < 64 else "More chat")


def preset_names(d):
    presets = d.get("equalizer_presets")
    if isinstance(presets, dict) and presets:
        return [str(k).replace("_", " ").capitalize() for k in presets]
    n = d.get("equalizer_presets_count") or 0
    return [f"Preset {i + 1}" for i in range(int(n))]


def pages():
    out = [{
        "id": page_id(d),
        "title": name_of(d),
        "icon": "audio-headset-symbolic",
        "description": "Battery, sidetone, lights and power-off timer.",
        "keywords": "headset headphones battery sidetone mic monitor lights led equalizer eq chatmix " + name_of(d).lower(),
    } for d in devices()]
    if a50x_plugged():
        out.append({"id": A50X, "title": A50X_TITLE, "icon": "audio-headset-symbolic", "description": A50X_DESC,
                    "keywords": "headset headphones astro a50 x logitech gearbench battery balance sidetone noise gate "
                                "microphone boom equalizer eq stream mix base station sleep tones"})
    return out


def describe(pid):
    if pid == A50X:
        return describe_a50x()
    _, d = find(pid)
    c = caps(d)
    st = load_state(pid)
    status = [{"kind": "info", "title": "Battery", "value": battery_text(d)}] if "CAP_BATTERY_STATUS" in c else []
    if "CAP_BATTERY_STATUS" in c:
        status.append({"kind": "switch", "key": "battery-warning", "title": "Warn when the battery is low",
                       "desc": f"A notification at {LOW}%, checked every five minutes.", "value": warning_on()})
    if "CAP_CHATMIX_STATUS" in c and d.get("chatmix") is not None:
        status.append({"kind": "info", "title": "Chat mix", "value": lean(int(d["chatmix"])), "tooltip": "Set with the dial on the headset."})

    sound = []
    if "CAP_SIDETONE" in c:
        sound.append({"kind": "slider", "key": "sidetone", "title": "Sidetone",
                      "desc": "Hear your own voice in the headset while you talk.",
                      "value": st.get("sidetone", 0), "min": 0, "max": 100, "unit": "%",
                      "keywords": "mic monitoring hear myself"})
    if "CAP_EQUALIZER_PRESET" in c and preset_names(d):
        opts = [[str(i), n] for i, n in enumerate(preset_names(d))]
        sound.append({"kind": "choice", "key": "eq", "title": "Equalizer preset", "options": opts,
                      "value": str(st.get("eq", "")), "keywords": "eq bass"})
    if "CAP_VOLUME_LIMITER" in c:
        sound.append({"kind": "switch", "key": "limiter", "title": "Volume limiter",
                      "desc": "Keep the volume at a safe level.", "value": st.get("limiter", False)})
    if "CAP_MICROPHONE_VOLUME" in c:
        sound.append({"kind": "slider", "key": "mic-volume", "title": "Microphone volume",
                      "value": st.get("mic-volume", 100), "min": 0, "max": 100, "unit": "%"})
    if "CAP_ROTATE_TO_MUTE" in c:
        sound.append({"kind": "switch", "key": "rotate-mute", "title": "Mute by raising the mic",
                      "value": st.get("rotate-mute", True)})
    if "CAP_VOICE_PROMPTS" in c:
        sound.append({"kind": "switch", "key": "voice", "title": "Voice prompts",
                      "desc": "Spoken announcements such as \"battery low\".", "value": st.get("voice", True)})

    device = []
    if "CAP_LIGHTS" in c:
        device.append({"kind": "switch", "key": "lights", "title": "Lights", "value": st.get("lights", True),
                       "keywords": "led rgb"})
    if "CAP_MICROPHONE_MUTE_LED_BRIGHTNESS" in c:
        device.append({"kind": "slider", "key": "mute-led", "title": "Mute light brightness",
                       "value": st.get("mute-led", 3), "min": 0, "max": 3})
    if "CAP_INACTIVE_TIME" in c:
        device.append({"kind": "choice", "key": "inactive", "title": "Turn off after",
                       "desc": "Switch the headset off when it's been silent this long.",
                       "options": INACTIVE, "value": str(st.get("inactive", "")), "keywords": "sleep power off idle"})
    if "CAP_BT_WHEN_POWERED_ON" in c:
        device.append({"kind": "switch", "key": "bt-on", "title": "Bluetooth on at power-on",
                       "value": st.get("bt-on", False)})

    if preview_supported():
        return headset_page(d, c, st, sound, device)
    groups = [g for g in (
        {"title": "Status", "rows": status},
        {"title": "Sound", "rows": sound},
        {"title": "Headset", "rows": device},
    ) if g["rows"]]
    out = {"subtitle": "Battery and chat mix are read from the headset; the rest shows what was last set here.",
           "poll": 30, "groups": groups}
    return out


SHORT_DESC = {"sidetone": "Your own voice, while you talk", "limiter": "Keeps the volume at a safe level",
              "voice": "Spoken announcements such as \u201cbattery low\u201d", "inactive": "When it's been silent this long"}


def headset_page(d, c, st, sound, device):
    """Style A: the controls on the left; the headset, its readings and the battery warning in the pane."""
    def pane_row(r):
        r = {**r, "icon": ICONS[r["key"]]}
        if r["key"] in SHORT_DESC:
            r["desc"] = SHORT_DESC[r["key"]]
        return r

    groups = [g for g in (
        {"title": "Sound", "rows": [pane_row(r) for r in sound]},
        {"title": "Headset", "rows": [pane_row(r) for r in device]},
    ) if g["rows"]]
    items = []
    if "CAP_BATTERY_STATUS" in c:
        items.append(battery_reading(d))
    if "CAP_CHATMIX_STATUS" in c and d.get("chatmix") is not None:
        items.append({"label": "Chat mix", "value": lean(int(d["chatmix"])), "sub": "The dial on the headset"})
    if "CAP_INACTIVE_TIME" in c and str(st.get("inactive", "")).isdigit():
        minutes = int(st["inactive"])
        items.append({"label": "Turns off", "value": f"After {minutes} min" if minutes else "Never",
                      "sub": "Of silence" if minutes else "Stays on"})
    blocks = [{"kind": "picture", "picture": "headset"}]
    if items:
        blocks.append({"kind": "stats", "items": items})
    if "CAP_BATTERY_STATUS" in c:
        blocks.append({"kind": "rows", "rows": [{
            "kind": "switch", "key": "battery-warning", "title": "Warn when the battery is low", "icon": BELL,
            "desc": f"A notification at {LOW}%, checked every five minutes", "value": warning_on()}]})
    preview = {"title": name_of(d), "line": "Battery and chat mix are read from the headset; the rest is what was last set here.",
               "blocks": blocks}
    return {"poll": 30, "groups": groups, "preview": preview}


# ------------------------------------------------------------------ low battery

TIMER = "nyx-headset-battery"
UNIT_DIR = os.path.expanduser("~/.config/systemd/user")
LOW = 15


def warning_on():
    if mock():
        return mock().warning_on(state_dir())
    return os.path.exists(os.path.join(UNIT_DIR, TIMER + ".timer"))


def set_warning(on):
    """A user timer that runs `battery-check` every five minutes."""
    if mock():
        mock().set_warning(state_dir(), on)
        return
    service = os.path.join(UNIT_DIR, TIMER + ".service")
    timer = os.path.join(UNIT_DIR, TIMER + ".timer")
    if on:
        os.makedirs(UNIT_DIR, exist_ok=True)
        env = f"Environment=SETTINGS_EXTENSION_STATE={STATE_DIR}\n" if STATE_DIR else ""
        with open(service, "w") as f:
            f.write(f"[Unit]\nDescription=Headset battery check (Settings)\n\n[Service]\nType=oneshot\n{env}"
                    f"ExecStart=/usr/bin/python3 {os.path.realpath(__file__)} battery-check\n")
        with open(timer, "w") as f:
            f.write("[Unit]\nDescription=Headset battery check (Settings)\n\n[Timer]\nOnBootSec=2min\nOnUnitActiveSec=5min\n\n"
                    "[Install]\nWantedBy=timers.target\n")
        subprocess.run(["systemctl", "--user", "daemon-reload"])
        subprocess.run(["systemctl", "--user", "enable", "--now", TIMER + ".timer"], capture_output=True)
    else:
        subprocess.run(["systemctl", "--user", "disable", "--now", TIMER + ".timer"], capture_output=True)
        for f in (service, timer):
            if os.path.exists(f):
                os.remove(f)
        subprocess.run(["systemctl", "--user", "daemon-reload"])


def battery_check():
    """Notify once when a headset's battery drops to LOW%; again after it's charged."""
    for d in devices():
        b = d.get("battery") or {}
        level = b.get("level", -1)
        flag = os.path.join(state_dir(), f"warned-{page_id(d)}")
        if b.get("status") == "BATTERY_AVAILABLE" and 0 <= level <= LOW:
            if not os.path.exists(flag):
                subprocess.run(["notify-send", "-u", "critical", "-i", "audio-headset-symbolic",
                                f"{name_of(d)}: {level}% battery", "Charge it soon."])
                os.makedirs(state_dir(), exist_ok=True)
                open(flag, "w").close()
        elif level > LOW + 10 and os.path.exists(flag):
            os.remove(flag)


def set_value(pid, key, value):
    if pid == A50X:
        return set_a50x(key, value)
    if key == "battery-warning":
        set_warning(value == "true")
        return None
    index, _ = find(pid)
    on = value == "true"
    num = lambda: round(float(value))  # noqa: E731
    args = {
        "sidetone": lambda: ["-s", str(round(num() * 1.28))],
        "eq": lambda: ["-p", value],
        "limiter": lambda: ["--volume-limiter", "1" if on else "0"],
        "mic-volume": lambda: ["--microphone-volume", str(round(num() * 1.28))],
        "rotate-mute": lambda: ["-r", "1" if on else "0"],
        "voice": lambda: ["-v", "1" if on else "0"],
        "lights": lambda: ["-l", "1" if on else "0"],
        "mute-led": lambda: ["--microphone-mute-led-brightness", str(num())],
        "inactive": lambda: ["-i", value],
        "bt-on": lambda: ["--bt-when-powered-on", "1" if on else "0"],
    }.get(key)
    if args is None:
        raise SystemExit(f"unknown setting {key}")
    r = run("-d", str(index), *args())
    if r.returncode != 0:
        raise SystemExit((r.stderr or r.stdout).strip() or "headsetcontrol failed")
    st = load_state(pid)
    st[key] = on if value in ("true", "false") else (num() if key in ("sidetone", "mic-volume", "mute-led") else value)
    save_state(pid, st)
    return None


