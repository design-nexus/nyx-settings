class GearbenchError(Exception):
    pass


def a50x_plugged():
    if mock():
        return mock().plugged_a50x()
    for dev in glob.glob("/sys/bus/usb/devices/*"):
        try:
            with open(os.path.join(dev, "idVendor")) as v, open(os.path.join(dev, "idProduct")) as p:
                if (v.read().strip().lower(), p.read().strip().lower()) == A50X_USB:
                    return True
        except OSError:
            continue
    return False


def gearbench_installed():
    return mock().gearbench_installed() if mock() else shutil.which("gearbench-ctl") is not None


def gearbench(*args):
    """`gearbench-ctl --json ARGS`: the daemon's reply, parsed."""
    if mock():
        code, out, err = mock().gearbench(list(args), state_dir())
    else:
        try:
            r = subprocess.run(["gearbench-ctl", "--json", *args], capture_output=True, text=True, timeout=15, check=False)
        except (OSError, subprocess.TimeoutExpired) as e:
            raise GearbenchError(str(e)) from e
        code, out, err = r.returncode, r.stdout, r.stderr
    if code != 0:
        raise GearbenchError((err or out).strip() or f"gearbench-ctl {args[0]} failed")
    try:
        return json.loads(out)
    except ValueError:
        return out


def a50x_entry(status):
    """The A50 X's entry in `status --json`'s headsets_attached (name, battery, answering, …)."""
    for h in (status.get("headsets_attached") or []) if isinstance(status, dict) else []:
        if isinstance(h, dict) and "A50 X" in str(h.get("name", "")):
            return h
    return None


def problems(status):
    """`status --json`'s problems as text. gearbench-ctl(1) names no field of an entry but
    `keyboard`, so an entry is taken as text itself, or its first other text field."""
    out = []
    for p in (status.get("problems") or []) if isinstance(status, dict) else []:
        if isinstance(p, dict):
            p = next((v for k, v in p.items() if k != "keyboard" and isinstance(v, str) and v), "")
        if isinstance(p, str) and p and p != "none":
            out.append(p)
    return out


def number(v):
    if isinstance(v, bool) or v is None:
        return None
    if isinstance(v, (int, float)):
        return round(v)
    m = re.match(r"\s*(-?\d+)", str(v))
    return int(m.group(1)) if m else None


def parse_audio(reply):
    """Reads `gearbench-ctl --json audio`. gearbench-ctl(1) says what `audio` reports (the
    battery, balance and boom, the microphone's settings, each equalizer's preset or `custom`,
    the stream mix and the other settings) and that --json prints the daemon's raw reply, but
    not that reply's field names: every guess about them is in this function. A value given as
    `not read`, or missing, is None."""
    if not isinstance(reply, dict):
        return {}
    flat = {}
    for part in (reply, reply.get("settings")):
        if isinstance(part, dict):
            flat.update({str(k).replace("-", "_"): v for k, v in part.items()})

    def get(*keys):
        v = next((flat[k] for k in keys if k in flat), None)
        return None if isinstance(v, str) and v.strip().lower() == "not read" else v

    def word(v):
        return None if v is None or isinstance(v, (dict, list)) else str(v).strip().lower()

    def onoff(v):
        return v if isinstance(v, bool) or v is None else word(v) in ("on", "true", "down", "live", "yes")

    eqs = get("equalizers", "equalizer")
    eqs = eqs if isinstance(eqs, dict) else {}
    mix = get("stream_mix", "mix")
    mix = mix if isinstance(mix, dict) else {}
    muted_list = mix.get("muted") if isinstance(mix.get("muted"), list) else []

    def preset(e):
        return word(e.get("preset") if isinstance(e, dict) else e)

    def level(s):
        v = mix.get(s)
        return number(v.get("level") if isinstance(v, dict) else v)

    def muted(s):
        v = mix.get(s)
        return bool(v.get("muted")) if isinstance(v, dict) else s in muted_list

    sleep = word(get("auto_sleep"))
    digits = re.match(r"\d+", sleep or "")
    return {
        "battery": number(get("battery")),
        "balance": number(get("balance")),
        "boom": onoff(get("boom")),
        "sidetone": number(get("sidetone")),
        "noise_gate": word(get("noise_gate")),
        "volume": number(get("volume")),
        "auto_sleep": None if sleep is None else "never" if sleep in ("never", "off") or (digits and int(digits.group()) == 0)
        else digits.group() if digits else sleep,
        "deep_sleep": onoff(get("deep_sleep")),
        "brightness": number(get("brightness")),
        "tones": word(get("tones")),
        "eq": {i: preset(eqs.get(i)) for i in PRESETS},
        "mix": {s: level(s) for s, _ in SOURCES},
        "muted": {s for s, _ in MUTABLE if muted(s)},
    }


def sound_devices():
    """The A50 X's outputs and inputs in PipeWire (through pactl), each with the apps using it."""
    if mock():
        return mock().sound_devices()

    def pactl(*args):
        try:
            r = subprocess.run(["pactl", *args], capture_output=True, text=True, timeout=3, check=False)
        except (OSError, subprocess.TimeoutExpired):
            return ""
        return r.stdout.strip()

    def listed(what):
        try:
            data = json.loads(pactl("-f", "json", "list", what) or "[]")
        except ValueError:
            return []
        return data if isinstance(data, list) else []

    out = []
    for kind, streams in (("sink", "sink-inputs"), ("source", "source-outputs")):
        default = pactl(f"get-default-{kind}")
        users = listed(streams)
        for n in listed(kind + "s"):
            desc = n.get("description") or ""
            props = n.get("properties") or {}
            if "A50 X" not in desc or "Stream" in desc or desc.startswith("Monitor of") or props.get("device.class") == "monitor":
                continue
            apps = sorted({(u.get("properties") or {}).get("application.name") for u in users if u.get(kind) == n.get("index")} - {None})
            out.append({"kind": kind, "name": desc, "default": n.get("name") == default, "apps": apps})
    return out


def sound_item(d):
    sink = d["kind"] == "sink"
    n = len(d["apps"])
    default = ("Default output" if sink else "Default input") if d["default"] else ""
    return {"icon": VOL if sink else MIC, "label": d["name"],
            "sub": " · ".join(x for x in (default, ", ".join(d["apps"])) if x),
            "value": "Default" if d["default"] else (f"{n} app" + ("" if n == 1 else "s")) if n else "",
            "tone": "good" if d["default"] else ""}


def control(row, value):
    """A row for a reading Gearbench may not have; greyed out and 'Not read' without one."""
    if value is None:
        return {**row, "value": row.get("min", ""), "disabled": True, "desc": "Not read"}
    return {**row, "value": value}


def a50x_groups(a):
    sound = []
    if a["balance"] is not None:
        sound.append({"kind": "slider", "key": "balance", "title": "Balance", "desc": "All voice at 0, all game at 12",
                      "icon": EQ, "value": a["balance"], "min": 0, "max": 12, "step": 1, "marks": [6], "on_release": True,
                      "keywords": "game chat voice mix dial"})
    sound.append(control({"kind": "slider", "key": "volume", "title": "Headset volume", "icon": VOL,
                          "min": 0, "max": 21, "step": 1, "on_release": True}, a["volume"]))

    mic = []
    if a["boom"] is not None:
        mic.append({"kind": "info", "title": "Boom", "desc": "Flip it up to mute", "icon": MIC,
                    "value": "Down · live" if a["boom"] else "Up · muted"})
    mic.append(control({"kind": "slider", "key": "sidetone", "title": "Sidetone", "desc": "Your own voice in the earcups",
                        "icon": MIC, "min": 0, "max": 6, "step": 1, "on_release": True,
                        "keywords": "mic monitoring hear myself"}, a["sidetone"]))
    mic.append(control({"kind": "segmented", "key": "noise-gate", "title": "Noise gate", "icon": MIC,
                        "options": NOISE_GATE}, a["noise_gate"]))

    eq = []
    for inst, title in (("headphones", "Headphones"), ("microphone", "Microphone")):
        row = control({"kind": "segmented", "key": f"eq-{inst}", "title": title, "icon": EQ,
                       "options": PRESETS[inst], "keywords": "equalizer eq preset"}, a["eq"][inst])
        if a["eq"][inst] == "custom":
            row.update(value="", desc="Custom bands")
        eq.append(row)

    stream = []
    for s, title in SOURCES:
        lvl = a["mix"].get(s)
        row = control({"kind": "slider", "key": f"mix-{s}", "title": title, "min": 0, "max": 100, "unit": "%",
                       "on_release": True, "icon": MIC if s == "mic" else BT if s == "bluetooth" else VOL},
                      None if lvl is None else round(lvl * 100 / 32))
        if s in a["muted"]:
            row["desc"] = "Muted"
        stream.append(row)
    stream.append({"kind": "chips", "key": "muted", "title": "Muted", "icon": "audio-volume-muted-symbolic",
                   "labels": [t for _, t in MUTABLE], "value": [s in a["muted"] for s, _ in MUTABLE], "refresh": True})

    base = [
        control({"kind": "segmented", "key": "auto-sleep", "title": "Auto sleep", "desc": "When it's idle this long",
                 "icon": POWER, "options": AUTO_SLEEP}, a["auto_sleep"]),
        control({"kind": "switch", "key": "deep-sleep", "title": "Deep sleep",
                 "desc": "The base station sleeps after 15 idle minutes", "icon": "weather-clear-night-symbolic"}, a["deep_sleep"]),
        control({"kind": "slider", "key": "brightness", "title": "Base station light", "icon": LIGHT,
                 "min": 0, "max": 100, "unit": "%", "on_release": True}, a["brightness"]),
        control({"kind": "segmented", "key": "tones", "title": "Tones", "desc": "Sounds at the ends of the wheel and dial",
                 "icon": BELL, "options": TONES}, a["tones"]),
    ]
    return [
        {"title": "Sound", "note": "The dial on the headset moves the balance too.", "rows": sound},
        {"title": "Microphone", "rows": mic},
        {"title": "Equalizers", "note": "The presets are the headset's own, kept in it.", "rows": eq},
        {"title": "Stream mix", "note": "What the base station's stream port sends, for streaming apps to record.", "rows": stream},
        {"title": "Headset and base station", "rows": base},
    ]


def open_gearbench_row():
    return {"kind": "button", "key": "open-gearbench", "title": "Open Gearbench", "desc": "Its window has every setting",
            "label": "Open", "icon": "go-jump-symbolic"}


def a50x_readings(a, battery):
    items = []
    if battery is not None:
        items.append({"label": "Battery", "value": f"{battery}%", "sub": "Charge soon" if battery <= LOW else "",
                      "tone": "bad" if battery <= LOW else "warn" if battery <= 30 else "good"})
    if a["balance"] is not None:
        game = round(a["balance"] * 100 / 12)
        items.append({"label": "Balance", "value": f"{game} / {100 - game}",
                      "sub": "Even" if game == 50 else "More game" if game > 50 else "More voice"})
    if a["boom"] is not None:
        items.append({"label": "Boom", "value": "Down" if a["boom"] else "Up",
                      "sub": "Microphone live" if a["boom"] else "Microphone muted"})
    return items


def describe_a50x():
    pane = preview_supported()
    if not gearbench_installed():
        return a50x_setup(pane)
    try:
        status = gearbench("status")
        a = parse_audio(gearbench("audio"))
    except GearbenchError as e:
        return a50x_unreachable(str(e), pane)
    entry = a50x_entry(status) or {}
    battery = number(entry.get("battery"))
    if battery is None:
        battery = a["battery"]
    banners = [{"text": "Gearbench: " + esc(p), "warning": True} for p in problems(status)]
    groups = a50x_groups(a)
    items = a50x_readings(a, battery)
    inputs = "PC, PlayStation and Xbox are switched on the base station itself."
    if not pane:
        readings = [{"kind": "info", "title": i["label"], "value": f"{i['value']} · {i['sub']}" if i["sub"] else i["value"]}
                    for i in items]
        status_group = [{"title": "Status", "note": inputs, "rows": readings}] if readings else []
        gearbench_group = {"title": "Gearbench", "note": ONE_DRIVER, "rows": [open_gearbench_row()]}
        return {"banners": banners, "poll": 10, "groups": status_group + groups + [gearbench_group]}
    line = "Through its base station" if entry.get("answering", True) else "Through its base station · the headset doesn't answer"
    blocks = [{"kind": "picture", "picture": "headset", "accent": TEAL}]
    if items:
        blocks.append({"kind": "stats", "items": items})
    sounds = [sound_item(d) for d in sound_devices()]
    if sounds:
        blocks.append({"kind": "list", "title": "On this computer", "items": sounds})
    blocks += [{"kind": "banner", "text": inputs}, {"kind": "rows", "rows": [open_gearbench_row()]}]
    preview = {"title": A50X_TITLE, "line": line, "blocks": blocks,
               "foot": "Run by Gearbench, which drives every Logitech G device it supports: no other program "
                       "should drive those devices too.", "foot_icon": "dialog-information-symbolic"}
    return {"banners": banners, "poll": 10, "groups": groups, "preview": preview}


def a50x_setup(pane):
    """Gearbench isn't installed: what it's for, and where to get it."""
    banner = {"text": "The A50 X plays sound already. Its controls come from <b>Gearbench</b>, "
                      "an open-source app for Logitech G devices.", "warning": False}
    row = {"kind": "button", "key": "install-gearbench", "title": "Install Gearbench",
           "desc": "Version 1.3.1, from its releases on GitHub", "label": "Open releases page",
           "icon": "system-software-install-symbolic", "keywords": "gearbench install download"}
    out = {"banners": [banner], "groups": [{"title": "Set up", "note": ONE_DRIVER, "rows": [row]}]}
    if pane:
        items = [
            {"icon": "object-select-symbolic", "label": "Sound works already", "sub": "Chat and the microphone"},
            {"icon": "folder-download-symbolic", "label": "The controls need Gearbench",
             "sub": "Balance, microphone, equalizers, stream mix, battery", "value": "Needed", "tone": "warn"},
            {"icon": "security-high-symbolic", "label": "Nothing leaves this computer",
             "sub": "No account; it sends nothing over the network"},
        ]
        out["preview"] = {"title": "A50 X found", "line": "Plugged in by USB",
                          "blocks": [{"kind": "picture", "picture": "headset", "accent": TEAL}, {"kind": "list", "items": items}]}
    return out


def a50x_unreachable(err, pane):
    banner = {"text": f"Gearbench didn't answer: {esc(err)}. Its service starts with "
                      "<tt>systemctl --user start gearbench</tt>, or when its window opens.", "warning": True}
    group = {"title": "Gearbench", "note": ONE_DRIVER, "rows": [open_gearbench_row()]}
    out = {"banners": [banner], "poll": 10, "groups": [group]}
    if pane:
        out["preview"] = {"title": A50X_TITLE, "line": "Plugged in by USB",
                          "blocks": [{"kind": "picture", "picture": "headset", "accent": TEAL}]}
    return out


def launch(argv):
    """Starts a program and leaves it running; in pretend mode, only says what it would run."""
    if mock():
        return {"toast": "Pretend mode: would run " + " ".join(argv)}
    try:
        subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except OSError as e:
        raise SystemExit(f"couldn't run {argv[0]}: {e}") from e
    return None


def set_a50x(key, value):
    if key == "install-gearbench":
        return launch(["xdg-open", GEARBENCH_RELEASES])
    if key == "open-gearbench":
        return launch(["gearbench-ctl", "gui"])
    try:
        if key == "muted":
            want = [v == "true" for v in value.split(",")]
            now = parse_audio(gearbench("audio")).get("muted", set())
            for (s, _), on in zip(MUTABLE, want):
                if on != (s in now):
                    gearbench("audio-mix", s, "--mute" if on else "--unmute")
            return {"refresh": True}
        num = lambda: str(round(float(value)))  # noqa: E731
        args = {
            "balance": lambda: ["audio-set", "balance", num()],
            "volume": lambda: ["audio-set", "volume", num()],
            "sidetone": lambda: ["audio-set", "sidetone", num()],
            "brightness": lambda: ["audio-set", "brightness", num()],
            "noise-gate": lambda: ["audio-set", "noise-gate", value],
            "auto-sleep": lambda: ["audio-set", "auto-sleep", value],
            "tones": lambda: ["audio-set", "tones", value],
            "deep-sleep": lambda: ["audio-set", "deep-sleep", "on" if value == "true" else "off"],
            "eq-headphones": lambda: ["audio-eq", "headphones", "--pick", value],
            "eq-microphone": lambda: ["audio-eq", "microphone", "--pick", value],
            **{f"mix-{s}": (lambda s=s: ["audio-mix", s, str(round(float(value) * 32 / 100))]) for s, _ in SOURCES},
        }.get(key)
        if args is None:
            raise SystemExit(f"unknown setting {key}")
        gearbench(*args())
    except GearbenchError as e:
        raise SystemExit(str(e)) from e
    return None


def main(argv):
    usage = "usage: settings-headset pages | describe PAGE | set PAGE KEY VALUE | battery-check"
    if not argv:
        raise SystemExit(usage)
    if argv[0] == "pages":
        print(json.dumps(pages()))
    elif argv[0] == "describe" and len(argv) >= 2:
        print(json.dumps(describe(argv[1])))
    elif argv[0] == "set" and len(argv) >= 4:
        reply = set_value(argv[1], argv[2], argv[3])
        if reply:
            print(json.dumps(reply))
    elif argv[0] == "theme-changed":
        pass
    elif argv[0] == "battery-check":
        battery_check()
    else:
        raise SystemExit(usage)


if __name__ == "__main__":
    main(sys.argv[1:])
